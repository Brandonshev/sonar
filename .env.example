# Copy to .env and fill in. Never commit .env.
SONAR_DB=data/sonar.db
SONAR_LOG_LEVEL=INFO

# v0.2 collectors
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
PRODUCTHUNT_TOKEN=

# v0.7: free key from Google Cloud Console (YouTube Data API v3)
YOUTUBE_API_KEY=

# v0.5 outputs
# Pick a long random topic (anyone who knows it can read it), subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# Dashboard address for links in alerts and the digest (set once the dashboard is up)
SONAR_PUBLIC_URL=
# Digest email (optional): a Gmail app password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# v0.6 dashboard: set both with  python -m sonar.web --set-password  (never put the plain password here)
SONAR_DASH_PASSWORD_HASH=
SONAR_SECRET=
