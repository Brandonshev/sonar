{
  "$schema": "./pipeline.schema.json",
  "version": 1,
  "nodes": [
    { "id": "github", "type": "source.github", "label": "GitHub", "enabled": false, "every": "3h", "params": {} },
    { "id": "hackernews", "type": "source.hackernews", "label": "Hacker News", "enabled": false, "every": "1h", "params": {} },
    { "id": "producthunt", "type": "source.producthunt", "label": "Product Hunt", "enabled": false, "every": "3h", "params": {} },
    { "id": "reddit", "type": "source.reddit", "label": "Reddit", "enabled": false, "every": "1h", "params": {} },

    { "id": "heat", "type": "scorer.heat", "label": "Heat score", "enabled": false,
      "params": { "baseline_days": 7, "floor": 1, "min_history_days": 8 } },
    { "id": "spikes", "type": "filter.threshold", "label": "Spike filter", "enabled": false,
      "params": { "min_heat": 5, "cooldown_hours": 24 } },

    { "id": "ntfy", "type": "output.ntfy", "label": "Instant alert", "enabled": false, "params": {} },
    { "id": "digest", "type": "output.email_digest", "label": "Daily digest", "enabled": false, "every": "1d", "params": {} },
    { "id": "dashboard", "type": "output.dashboard", "label": "Dashboard", "enabled": false, "params": {} }
  ],
  "edges": [
    ["github", "heat"], ["hackernews", "heat"], ["producthunt", "heat"], ["reddit", "heat"],
    ["heat", "spikes"], ["spikes", "ntfy"],
    ["heat", "digest"], ["heat", "dashboard"]
  ]
}
