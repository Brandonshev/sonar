{
  "$schema": "./pipeline.schema.json",
  "version": 1,
  "nodes": [
    {"id": "github", "type": "source.github", "label": "GitHub", "enabled": true, "every": "3h", "params": {"created_within_days": 30, "min_stars": 10, "search_pages": 2, "max_tracked": 300, "reserve_requests": 50}},
    {"id": "hackernews", "type": "source.hackernews", "label": "Hacker News", "enabled": true, "every": "1h", "params": {"top": 100, "new": 100, "best": 50, "workers": 6}},
    {"id": "producthunt", "type": "source.producthunt", "label": "Product Hunt", "enabled": true, "every": "2h", "params": {"days": 2, "limit": 50, "resolve_per_run": 20}},
    {"id": "reddit", "type": "source.reddit", "label": "Reddit (off until API access is approved)", "enabled": false, "every": "1h", "params": {"subreddits": ["technology", "programming", "webdev", "MachineLearning", "artificial", "LocalLLaMA", "OpenAI", "ClaudeAI", "singularity", "ChatGPT", "StableDiffusion", "selfhosted", "opensource", "coolgithubprojects", "homelab", "gadgets", "apple", "android", "iphone", "Futurology", "cybersecurity", "devops", "rust", "golang", "Python", "javascript", "reactjs", "gamedev", "indiegaming", "nocode", "SideProject", "startups", "Entrepreneur", "SaaS", "indiehackers", "EntrepreneurRideAlong", "smallbusiness", "Startup_Ideas", "AppIdeas", "InternetIsBeautiful", "alphaandbetausers", "ProductHunters", "microsaas", "juststart", "sweatystartup", "ecommerce", "shopify", "dropship", "NewTubers", "youtubers", "PartneredYoutube", "TikTokCringe", "Tiktokhelp", "InstagramMarketing", "socialmedia", "content_marketing", "marketing", "VideoEditing", "podcasting", "memes", "dankmemes", "me_irl", "NoStupidQuestions", "OutOfTheLoop", "BeAmazed", "nextfuckinglevel", "interestingasfuck", "Damnthatsinteresting", "mildlyinteresting", "oddlysatisfying", "TikTokTrends", "viral", "videos", "Unexpected", "MadeMeSmile", "AskReddit", "todayilearned", "stocks", "investing", "wallstreetbets", "StockMarket", "options", "pennystocks", "ValueInvesting", "dividends", "CryptoCurrency", "Bitcoin", "ethereum", "SecurityAnalysis", "economy", "finance", "RobinHood", "ausstocks", "AusFinance", "fiaustralia", "popculturechat", "Music", "hiphopheads", "movies", "television", "gaming", "Games", "pcgaming", "NintendoSwitch", "PS5", "anime", "fashion", "malefashionadvice", "femalefashionadvice", "sneakers", "BuyItForLife", "Frugal", "food", "FoodPorn", "fitness", "SkincareAddiction", "travel", "books", "boardgames", "worldnews", "news", "australia", "sydney", "science", "space", "EverythingScience", "UpliftingNews", "nottheonion", "environment", "energy", "electricvehicles", "teslamotors"], "listings": ["rising", "hot"], "limit": 25}},
    {"id": "youtube", "type": "source.youtube", "label": "YouTube", "enabled": true, "every": "3h", "params": {"regions": ["AU", "US", "GB"], "topics": ["AI tools", "tech review", "startup", "viral trend", "TikTok trend", "stock market"], "search_rounds_per_day": 4, "search_days": 2, "search_results": 25, "track_days": 7, "max_tracked": 400, "daily_budget": 8000}},
    {"id": "google_trends", "type": "source.google_trends", "label": "Google Trends", "enabled": true, "every": "1h", "params": {"geos": ["AU", "US", "GB"]}},
    {"id": "google_trends_rising", "type": "source.google_trends_rising", "label": "Google Trends rising", "enabled": true, "every": "6h", "params": {"geo": "AU", "topics": ["AI app", "app", "startup", "TikTok", "YouTube", "stock"], "per_topic": 10, "timeframe": "now 7-d", "pause_seconds": 5}},
    {"id": "wikipedia", "type": "source.wikipedia", "label": "Wikipedia", "enabled": true, "every": "6h", "params": {"top": 100, "lookups_per_run": 25, "lookup_min_score": 20, "track_days": 14, "max_tracked": 300, "backfill_days": 10, "workers": 4}},
    {"id": "heat", "type": "scorer.heat", "label": "Heat score", "enabled": true, "params": {"baseline_days": 7, "new_item_hours": 48, "early_weight": 1.0, "cross_source_bonus_pct": 25, "cross_source_min_heat": 2, "heat_for_100": 20, "trend_min_heat": 5, "metrics": {"github": {"stars": 5, "forks": 2}, "hackernews": {"points": 10, "comments": 5}, "producthunt": {"votes": 10, "comments": 3}, "reddit": {"score": 20, "comments": 5}, "youtube": {"views": 5000, "likes": 200}, "google_trends": {"traffic": 1000}, "google_trends_rising": {"rise_pct": 100}, "wikipedia": {"views": 2000}}}},
    {"id": "alerts", "type": "output.ntfy_alert", "label": "Instant spike alert", "enabled": true, "params": {"min_heat": 5, "min_score": 0, "cooldown_hours": 24, "rejump_score": 20, "max_per_hour": 5, "warmup_hours": 24}},
    {"id": "digest", "type": "output.digest", "label": "Daily digest", "enabled": true, "at": "07:00", "tz": "Australia/Sydney", "params": {"top_per_source": 10, "new_entries": 10, "email": true}},
    {"id": "dashboard", "type": "output.dashboard", "label": "Dashboard", "enabled": true, "params": {"host": "127.0.0.1", "port": 8390, "top_n": 40, "tabs": {"Social": ["reddit", "tiktok", "instagram"], "YouTube": ["youtube"], "Tech products": ["producthunt", "hackernews"], "GitHub": ["github"], "Companies": ["companies", "news"], "Other": []}}}
  ],
  "edges": [["github", "heat"], ["hackernews", "heat"], ["producthunt", "heat"], ["reddit", "heat"], ["heat", "digest"], ["heat", "dashboard"], ["heat", "alerts"], ["youtube", "heat"], ["google_trends", "heat"], ["google_trends_rising", "heat"], ["wikipedia", "heat"]]
}
